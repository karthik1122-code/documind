{
  "name": "documind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Retrieval-augmented question answering over documentation, built eval-first.",
  "scripts": {
    "test": "node --test",
    "eval": "node eval/run.mjs",
    "eval:write": "node eval/run.mjs --write",
    "verify:questions": "node eval/verify-questions.mjs",
    "start": "node server.mjs",
    "eval:ablation": "node eval/ablation.mjs",
    "eval:answer": "node eval/answer-eval.mjs",
    "eval:gemini": "node eval/run-gemini.mjs --write",
    "eval:llm": "node eval/answer-eval-llm.mjs --write",
    "test:e2e": "node --test e2e/*.e2e.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
